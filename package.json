{
  "name": "code-server",
  "version": "0.1.0-lite.1",
  "private": true,
  "license": "MIT",
  "description": "Minimal authenticated remote file editor and Git manager; no VS Code runtime.",
  "type": "module",
  "engines": { "node": "24" },
  "bin": { "code-server": "lite/server.mjs" },
  "main": "lite/server.mjs",
  "files": ["lite/server.mjs", "lite/files.mjs", "lite/git.mjs", "lite/state.mjs", "lite/public/", "README.md", "LICENSE", "docs/mcp-lite-editor.md"],
  "scripts": {
    "start": "node lite/server.mjs",
    "build": "node lite/check.mjs",
    "test": "node --test lite/test/*.test.mjs",
    "test:browser": "node lite/browser-smoke.mjs",
    "measure": "node lite/measure.mjs",
    "package": "npm pack --ignore-scripts",
    "test:release": "bash scripts/test-release-ubuntu.sh"
  }
}
